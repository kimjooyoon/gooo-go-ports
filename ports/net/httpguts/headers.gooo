//
// Modifications: expand the token table into numeric byte predicates and use
// a fixed 1024-byte scan. Domain: decoded valid UTF-8 Text, byte length 0..1024.
// REQUIRED OUTER REFUSAL: absent/wrong-type/invalid UTF-8/>1024-byte input.
// These activities cannot enforce that transport contract themselves. An
// out-of-domain call has no supported result; do not interpret one as false.
// Empty name is false; empty value is true. No trim or normalization.
// Names retain HTTP/1.x uppercase semantics. Values retain the upstream
// leading/trailing SP/HTAB allowance. No HTTP/2, authorization or send claim.
package httpguts
namespace gooo_ports_x_net_httpguts
entity Text id "gooo://std/text"
entity Boolean id "gooo://std/boolean"

activity ValidHeaderFieldName(Text) -> Boolean id "gooo://golang.org/x/net/http/httpguts/ValidHeaderFieldName" computes `let size = int64(len(input))
if size == 0 { return false }
let offset = 0
for offset = 0; offset < 1024; offset = offset + 1 {
    if offset >= size { return true }
    let octet = int64(input[offset])
    let token = (octet >= 48 && octet <= 57) || (octet >= 65 && octet <= 90) || (octet >= 97 && octet <= 122) || octet == 33 || (octet >= 35 && octet <= 39) || octet == 42 || octet == 43 || octet == 45 || octet == 46 || octet == 94 || octet == 95 || octet == 96 || octet == 124 || octet == 126
    if !token { return false }
}
return true`

activity ValidHeaderFieldValue(Text) -> Boolean id "gooo://golang.org/x/net/http/httpguts/ValidHeaderFieldValue" computes `let size = int64(len(input))
let offset = 0
for offset = 0; offset < 1024; offset = offset + 1 {
    if offset >= size { return true }
    let octet = int64(input[offset])
    if (octet < 32 && octet != 9) || octet == 127 { return false }
}
return true`
