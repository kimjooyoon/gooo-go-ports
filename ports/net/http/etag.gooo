//
// Bounded adaptation of Go1.27.2 at 022c8636110ebac86a9b88724cda168ed713c21f:
// src/net/http/fs.go scanETag/etagStrongMatch, lines435..467, SHA256:
// 21660cb61d17c258de99172683f9b41aca37d45c0af0556723f2a11179bdc45e.
// src/net/textproto/textproto.go TrimString/isASCIISpace, lines126..150, SHA256:
// e4f0d94752345b5dec4fe7f4805531e8036a9cd44131d807cafa700dd5323901.
//
// API difference: the original HTTP helpers are unexported. This dedicated
// Gooo package is not an official Go net/http/etag subpackage. Go's two scan
// returns become one required two-field record in original etag/remain order.
// Modifications: bounded byte-index loops replace unbounded Go string loops;
// TrimString's exact SP/HT/LF/CR edge trimming is performed inside ScanETag.
// Backslash is literal; it never escapes the following quote. A quoted empty
// opaque tag is present, unlike the zero-byte failure sentinel. Remainder is
// preserved after the first complete tag, with no list/wildcard interpretation.
// ETagStrongMatch retains raw equality/nonempty/opening-quote semantics even
// for grammar-invalid quoted strings. It does not scan, trim or validate.
//
// DOMAIN: every decoded Unicode-scalar validUTF8 Text of0..1024 bytes, including
// empty, NUL, controls and grammar-invalid input. Each strong-match operand has
// that same independent bound. REQUIRED OUTER REFUSAL rejects missing/wrong
// types, duplicate binding keys, malformed UTF8, unpaired surrogates or >1024
// bytes before binding. These pure activities cannot enforce that transport
// contract; an out-of-domain result is unsupported, not a false/empty extension.
// No truncation, Unicode normalization/casefolding/unescaping, arbitrary-byte
// Go strings, full If-Match/ServeContent, HTTP effect or authorization claim.
package httpetag
namespace httpetag
entity Text id "gooo://std/text"
entity Boolean id "gooo://std/boolean"
entity ETagScanResult id "gooo://go/net/http/etag-scan-result/v1" fields {
    field etag id "gooo://go/net/http/etag-scan-result/v1/etag" type string required one
    field remain id "gooo://go/net/http/etag-scan-result/v1/remain" type string required one
}

activity ScanETag(Text) -> ETagScanResult id "gooo://go/net/http/scan-etag" computes `let size = int64(len(input))
let left = 0
let right = size
let leading = true
let offset = 0
for offset = 0; offset < 1024; offset = offset + 1 {
    if leading && offset < size {
        let octet = int64(input[offset])
        if octet == 32 || octet == 9 || octet == 10 || octet == 13 {
            left = offset + 1
        } else {
            leading = false
        }
    }
}
let trailing = true
for offset = 0; offset < 1024; offset = offset + 1 {
    let position = size - offset - 1
    if trailing && position >= left {
        let octet = int64(input[position])
        if octet == 32 || octet == 9 || octet == 10 || octet == 13 {
            right = position
        } else {
            trailing = false
        }
    }
}
let text = input[left:right]
let text_size = right - left
let start = 0
if text_size >= 2 {
    if int64(text[0]) == 87 && int64(text[1]) == 47 { start = 2 }
}
if text_size - start < 2 { return ETagScanResult{etag: "", remain: ""} }
if int64(text[start]) != 34 { return ETagScanResult{etag: "", remain: ""} }
for offset = 0; offset < 1024; offset = offset + 1 {
    let position = start + 1 + offset
    if position >= text_size { return ETagScanResult{etag: "", remain: ""} }
    let octet = int64(text[position])
    if octet == 34 {
        let end = position + 1
        return ETagScanResult{etag: text[0:end], remain: text[end:text_size]}
    }
    let allowed = octet == 33 || (octet >= 35 && octet <= 126) || octet >= 128
    if !allowed { return ETagScanResult{etag: "", remain: ""} }
}
return ETagScanResult{etag: "", remain: ""}`

activity ETagStrongMatch(Text, Text) -> Boolean id "gooo://go/net/http/etag-strong-match" computes `if input0 != input1 || input0 == "" { return false }
return int64(input0[0]) == 34`
