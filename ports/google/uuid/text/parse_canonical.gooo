// This separate Text API preserves the returned UUID as canonical text on both
// success and error. Inputs are decoded valid UTF-8 Text of at most 1024 bytes.
// It is not the Go binary UUID method set or the arbitrary-byte ParseBytes API.
package uuidtext
namespace gooo_ports_google_uuid_text
import uuid "go/github.com/google/uuid"
import quote "go/github.com/google/uuid/internal/quote"
entity Text id "gooo://std/text"
entity Integer id "gooo://std/integer"
entity Boolean id "gooo://std/boolean"
entity ParseCanonicalResult id "gooo://github.com/google/uuid/text/parse-canonical-result" fields {
 field parsed id "gooo://github.com/google/uuid/text/parse-canonical-result/parsed" type boolean required one
 field canonical_uuid id "gooo://github.com/google/uuid/text/parse-canonical-result/canonical-uuid" type string required one
 field error id "gooo://github.com/google/uuid/text/parse-canonical-result/error" type string required one
 field invalid_length id "gooo://github.com/google/uuid/text/parse-canonical-result/invalid-length" type boolean required one
}
activity HexValue(Integer) -> Integer id "gooo://github.com/google/uuid/text/hex-value" computes `if input >= 48 && input <= 57 { return input - 48 }
if input >= 65 && input <= 70 { return input - 55 }
if input >= 97 && input <= 102 { return input - 87 }
return 255`
activity ByteHex(Integer) -> Text id "gooo://github.com/google/uuid/text/byte-hex" computes `let digits = "0123456789abcdef"
let high = (input / 16) % 16
let low = input % 16
return digits[high:high + 1] + digits[low:low + 1]`
activity ParseCanonical(Text) -> ParseCanonicalResult id "gooo://github.com/google/uuid/text/parse-canonical" computes `let length = int64(len(input))
let canonical = "00000000-0000-0000-0000-000000000000"
if length != 32 && length != 36 && length != 38 && length != 45 {
 return ParseCanonicalResult{parsed: false, canonical_uuid: canonical, error: "invalid UUID length: " + uuid.DecimalLength(input), invalid_length: true}
}
let text = input
if length == 45 {
 if !uuid.URNPrefix(input) {
  return ParseCanonicalResult{parsed: false, canonical_uuid: canonical, error: "invalid urn prefix: " + quote.QuotePrefix9(input), invalid_length: false}
 }
 text = input[9:]
}
if length == 38 { text = input[1:37] }
if length != 32 {
 if int64(text[8]) != 45 || int64(text[13]) != 45 || int64(text[18]) != 45 || int64(text[23]) != 45 {
  return ParseCanonicalResult{parsed: false, canonical_uuid: canonical, error: "invalid UUID format", invalid_length: false}
 }
}
let byteIndex = 0
for byteIndex = 0; byteIndex < 16; byteIndex = byteIndex + 1 {
 let canonicalOffset = byteIndex * 2
 if byteIndex >= 4 { canonicalOffset = canonicalOffset + 1 }
 if byteIndex >= 6 { canonicalOffset = canonicalOffset + 1 }
 if byteIndex >= 8 { canonicalOffset = canonicalOffset + 1 }
 if byteIndex >= 10 { canonicalOffset = canonicalOffset + 1 }
 let textOffset = canonicalOffset
 if length == 32 { textOffset = byteIndex * 2 }
 let high = HexValue(int64(text[textOffset]))
 let low = HexValue(int64(text[textOffset + 1]))
 if length != 32 && (high == 255 || low == 255) {
  return ParseCanonicalResult{parsed: false, canonical_uuid: canonical, error: "invalid UUID format", invalid_length: false}
 }
 // Raw32 commits xtob's byte before reporting failure; standard form does not.
 let decoded = (high % 16) * 16 + low
 if low == 255 { decoded = 255 }
 canonical = canonical[:canonicalOffset] + ByteHex(decoded) + canonical[canonicalOffset + 2:]
 if high == 255 || low == 255 {
  return ParseCanonicalResult{parsed: false, canonical_uuid: canonical, error: "invalid UUID format", invalid_length: false}
 }
}
return ParseCanonicalResult{parsed: true, canonical_uuid: canonical, error: "", invalid_length: false}`
