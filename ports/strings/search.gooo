//
// This preserves the first matching byte offset for valid UTF-8 Text of
// at most 1024 bytes and original Go byte needles 0..255. Go strings can
// contain arbitrary bytes and have no 1024-byte bound; those are not supported.
// An Integer outside 0..255 returns -1 as an explicit extension, without
// narrowing to byte. The native input route enforces the Text size/UTF-8
// boundary before execution. The length guard precedes every byte access.
package strings
namespace gooo_ports_strings
entity Text id "gooo://std/text"
entity Integer id "gooo://std/integer"

activity IndexByte(Text, Integer) -> Integer id "gooo://go/strings/IndexByte" computes `if input1 < 0 || input1 > 255 { return -1 }
let offset = 0
for offset = 0; offset < 1024; offset = offset + 1 {
    if offset >= int64(len(input0)) { return -1 }
    if int64(input0[offset]) == input1 { return offset }
}
return -1`
