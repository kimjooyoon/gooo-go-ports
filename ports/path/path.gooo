// Bounded adaptation of Go 1.27.2 path.Ext and path.IsAbs at
// 022c8636110ebac86a9b88724cda168ed713c21f.
// src/path/path.go SHA256:
// 0a5024c364387eeea9ab5fe0b285f0d62355e8cd181cdbddfdfa227f6916d94c.
// Modification: scan forward with the supported fixed 1024-iteration loop,
// remembering the latest dot since the latest slash, rather than decrementing
// an unbounded upstream byte index. Only decoded valid UTF-8 Text <=1024 bytes
// is accepted. Backslash remains an ordinary byte. No cleaning, normalization,
// path existence check, filesystem permission or full path-package API is added.
package path
namespace gooo_ports_path

entity Text id "gooo://std/text"
entity Boolean id "gooo://std/boolean"

activity Ext(Text) -> Text id "gooo://go/path/Ext" computes `let size = int64(len(input))
let dot = -1
let offset = 0
for offset = 0; offset < 1024; offset = offset + 1 {
    if offset >= size {
        if dot < 0 { return "" }
        return input[dot:size]
    }
    if input[offset] == 47 { dot = -1 }
    if input[offset] == 46 { dot = offset }
}
if dot < 0 { return "" }
return input[dot:size]`

activity IsAbs(Text) -> Boolean id "gooo://go/path/IsAbs" computes `if len(input) == 0 { return false }
return input[0] == 47`
