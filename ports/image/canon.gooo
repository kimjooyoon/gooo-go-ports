// Adapted from Go 1.27.2 src/image/geom.go Rectangle.Canon, revision
// 022c8636110ebac86a9b88724cda168ed713c21f.
// Source SHA-256: 7cc4be83e978cc172e0ebb9713a6afd77ccf3ceb82d9cbc6f79082e698884ec2.
// Candidate only. Exact int64 coordinates preserve the Go int domain on 64-bit Go.
// Coordinate comparisons and swaps only; equality remains degenerate.
package image
namespace gooo_ports_image
activity RectangleCanon(Rectangle) -> Rectangle id "gooo://go/image/rectangle-canon" computes `let min_x = input.min_x
let min_y = input.min_y
let max_x = input.max_x
let max_y = input.max_y
if max_x < min_x { min_x = input.max_x
max_x = input.min_x }
if max_y < min_y { min_y = input.max_y
max_y = input.min_y }
return Rectangle{min_x: min_x, min_y: min_y, max_x: max_x, max_y: max_y}`
