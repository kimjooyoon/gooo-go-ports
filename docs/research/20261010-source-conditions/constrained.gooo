package byteguard
namespace byteguard
entity Integer id "byteguard://integer"

activity ByteOrReject(Integer) -> Integer computes `let outside = input < 0 || input > 255
let inside = input >= 0 && input <= 255
if outside { return input } else { return -1 }` assembling {
    choice "predicate" local_reference at "0" alternative "inside" intent "Use the outside-byte-domain predicate."
    choice "outside-branch" branch_layout at "0" intent "Reject inputs outside zero through 255."
    case "-9223372036854775808" -> "-1"
    case "-9007199254740993" -> "-1"
    case "-2" -> "-1"
    case "-1" -> "-1"
    case "0" -> "0"
    case "1" -> "1"
    case "127" -> "127"
    case "254" -> "254"
    case "255" -> "255"
    case "256" -> "-1"
    case "257" -> "-1"
    case "9007199254740993" -> "-1"
    case "9223372036854775807" -> "-1"
    condition_case "outside-branch" input "-9223372036854775808" -> "true"
    condition_case "outside-branch" input "-9007199254740993" -> "true"
    condition_case "outside-branch" input "-2" -> "true"
    condition_case "outside-branch" input "-1" -> "true"
    condition_case "outside-branch" input "0" -> "false"
    condition_case "outside-branch" input "1" -> "false"
    condition_case "outside-branch" input "127" -> "false"
    condition_case "outside-branch" input "254" -> "false"
    condition_case "outside-branch" input "255" -> "false"
    condition_case "outside-branch" input "256" -> "true"
    condition_case "outside-branch" input "257" -> "true"
    condition_case "outside-branch" input "9007199254740993" -> "true"
    condition_case "outside-branch" input "9223372036854775807" -> "true"
    attempts "4"
}

activity Main(Integer) -> Integer computes "return ByteOrReject(input)"
