// Copyright 2026 Gooo Go Ports contributors.
// BSD-3-Clause: see LICENSE. Original equal-priority IPv4 rule-pair composition.
// Both original8-field input records are bound in receipt inputs, not duplicated
// in the11-field result. These shapes fit the pinned16-field record limit.
// scope is a caller-assigned positive opaque key. Equality does not establish
// truthful, authenticated, fresh or identical tenant/action/protocol/port context.
// Invalid or non-comparable inputs have conflict=false, which is NOT permission,
// safety, a successful comparison, or evidence that a whole ACL is conflict-free.
// No actual request, I/O, host adapter, ledger or human-approval flow exists here.
package ipv4_rule_pair
namespace gooo_original_ipv4_rule_pair
import netip "go/net/netip"

entity Rule id "gooo://ipv4-rule-pair/rule/v1" fields {
    field a id "gooo://ipv4-rule-pair/rule/v1/a" type integer required one
    field b id "gooo://ipv4-rule-pair/rule/v1/b" type integer required one
    field c id "gooo://ipv4-rule-pair/rule/v1/c" type integer required one
    field d id "gooo://ipv4-rule-pair/rule/v1/d" type integer required one
    field bits id "gooo://ipv4-rule-pair/rule/v1/bits" type integer required one
    field effect id "gooo://ipv4-rule-pair/rule/v1/effect" type integer required one
    field scope id "gooo://ipv4-rule-pair/rule/v1/scope" type integer required one
    field priority id "gooo://ipv4-rule-pair/rule/v1/priority" type integer required one
}
entity RulePairReport id "gooo://ipv4-rule-pair/result/v2" fields {
    field valid id "gooo://ipv4-rule-pair/result/v2/valid" type boolean required one
    field comparable id "gooo://ipv4-rule-pair/result/v2/comparable" type boolean required one
    field overlap id "gooo://ipv4-rule-pair/result/v2/overlap" type boolean required one
    field opposing_effect id "gooo://ipv4-rule-pair/result/v2/opposing_effect" type boolean required one
    field conflict id "gooo://ipv4-rule-pair/result/v2/conflict" type boolean required one
    field witness_valid id "gooo://ipv4-rule-pair/result/v2/witness_valid" type boolean required one
    field witness_a id "gooo://ipv4-rule-pair/result/v2/witness_a" type integer required one
    field witness_b id "gooo://ipv4-rule-pair/result/v2/witness_b" type integer required one
    field witness_c id "gooo://ipv4-rule-pair/result/v2/witness_c" type integer required one
    field witness_d id "gooo://ipv4-rule-pair/result/v2/witness_d" type integer required one
    field reason id "gooo://ipv4-rule-pair/result/v2/reason" type integer required one
}

// priority intentionally accepts every signed int64; comparison uses equality.
activity RuleValid(Rule) -> Boolean id "gooo://ipv4-rule-pair/rule-valid/v1" computes `return input.a >= 0 && input.a <= 255 && input.b >= 0 && input.b <= 255 && input.c >= 0 && input.c <= 255 && input.d >= 0 && input.d <= 255 && input.bits >= 0 && input.bits <= 32 && input.effect >= 0 && input.effect <= 1 && input.scope > 0`

// reason precedence:0 invalid,1 scope mismatch,2 priority mismatch,3 disjoint,
// 4 same effect,5 conflict. Facts overlap/opposing_effect remain independent of
// comparability after both domains validate; witness_valid is exactly conflict.
activity Report(Rule, Rule) -> RulePairReport id "gooo://ipv4-rule-pair/report/v2" computes `let valid = RuleValid(input0) && RuleValid(input1)
let comparable = false
let overlap = false
let opposing_effect = false
let conflict = false
let witness_valid = false
let witness_a = 0
let witness_b = 0
let witness_c = 0
let witness_d = 0
let reason = 0
if valid {
    let left_prefix = IPv4Prefix{a: input0.a, b: input0.b, c: input0.c, d: input0.d, bits: input0.bits}
    let right_prefix = IPv4Prefix{a: input1.a, b: input1.b, c: input1.c, d: input1.d, bits: input1.bits}
    overlap = netip.PrefixOverlaps(left_prefix, right_prefix)
    opposing_effect = input0.effect != input1.effect
    if input0.scope != input1.scope {
        reason = 1
    } else {
        if input0.priority != input1.priority {
            reason = 2
        } else {
            comparable = true
            if !overlap {
                reason = 3
            } else {
                if !opposing_effect {
                    reason = 4
                } else {
                    reason = 5
                    conflict = true
                    witness_valid = true
                    // Both complete domains validated before any arithmetic.
                    // A more-specific network is inside the other on overlap.
                    // Equal bit lengths retain the left source; masked results
                    // coincide for overlapping prefixes of the same length.
                    let bits = input0.bits
                    let packed = input0.a * 16777216 + input0.b * 65536 + input0.c * 256 + input0.d
                    if input1.bits > bits {
                        bits = input1.bits
                        packed = input1.a * 16777216 + input1.b * 65536 + input1.c * 256 + input1.d
                    }
                    let divisor = netip.IPv4PrefixDivisor(bits)
                    let network = packed / divisor * divisor
                    witness_a = network / 16777216
                    witness_b = network / 65536 % 256
                    witness_c = network / 256 % 256
                    witness_d = network % 256
                }
            }
        }
    }
}
return RulePairReport{valid: valid, comparable: comparable, overlap: overlap, opposing_effect: opposing_effect, conflict: conflict, witness_valid: witness_valid, witness_a: witness_a, witness_b: witness_b, witness_c: witness_c, witness_d: witness_d, reason: reason}`
