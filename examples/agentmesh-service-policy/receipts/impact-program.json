  "lowered_gooo_source": "package gooo_workspace\nnamespace gooo_workspace\n\nentity Text id \"gooo://std/text\"\nentity Boolean id \"gooo://std/boolean\"\nentity GrantImpact id \"gooo://service-impact/decision/v1\" fields {\n    field before_match id \"gooo://service-impact/before\" type boolean required one\n    field after_match id \"gooo://service-impact/after\" type boolean required one\n    field change id \"gooo://service-impact/change\" type string required one\n}\nactivity GoooPackage0ActivityMatchServicePattern(Text, Text, Text) -> Boolean id \"gooo://agentmesh-prototype/match-service-pattern\" computes \"\\nif input0 == \\\"\\\" || input1 == \\\"\\\" || input2 == \\\"\\\" { return false }\\nif input0 == \\\"*\\\" { return true }\\nlet split = -1\\nlet offset = 0\\nfor offset = 0; offset < 128; offset = offset + 1 {\\n let end = offset + 3\\n if end <= int64(len(input0)) {\\n  if input0[offset:end] == \\\"://\\\" { if split == -1 { split = offset } }\\n }\\n}\\nif split < 0 { return false }\\nlet nameStart = split + 3\\nlet patternType = input0[0:split]\\nlet patternName = input0[nameStart:int64(len(input0))]\\nif patternType != input1 || patternName == \\\"\\\" { return false }\\nif patternName == \\\"*\\\" { return true }\\nlet patternLength = int64(len(patternName))\\nlet requestLength = int64(len(input2))\\nif patternLength >= 2 {\\n if patternName[0:2] == \\\"*.\\\" {\\n  let suffix = patternName[1:patternLength]\\n  let suffixLength = int64(len(suffix))\\n  if requestLength < suffixLength { return false }\\n  let suffixStart = requestLength - suffixLength\\n  return input2[suffixStart:requestLength] == suffix\\n }\\n let tailStart = patternLength - 2\\n if patternName[tailStart:patternLength] == \\\".*\\\" {\\n  let prefixEnd = patternLength - 1\\n  let prefix = patternName[0:prefixEnd]\\n  if requestLength < prefixEnd { return false }\\n  return input2[0:prefixEnd] == prefix\\n }\\n}\\nreturn input2 == patternName\\n\"\nactivity GoooPackage1ActivityCompareServiceGrant(Text, Text, Text, Text) -> GrantImpact id \"gooo://service-impact/compare\" computes \"\\nlet before = GoooPackage0ActivityMatchServicePattern(input0, input2, input3)\\nlet after = GoooPackage0ActivityMatchServicePattern(input1, input2, input3)\\nlet change = \\\"UNCHANGED_DENY\\\"\\nif before {\\n if after { change = \\\"UNCHANGED_ALLOW\\\" } else { change = \\\"REVOKED\\\" }\\n} else {\\n if after { change = \\\"WIDENED\\\" }\\n}\\nreturn GrantImpact{before_match: before, after_match: after, change: change}\\n\"\n",
