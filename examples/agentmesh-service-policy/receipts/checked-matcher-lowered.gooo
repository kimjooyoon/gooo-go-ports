package gooo_workspace
namespace gooo_workspace

entity Text id "gooo://std/text"
entity Boolean id "gooo://std/boolean"
entity CheckedMatcherDecision id "gooo://service-policy/checked-matcher/decision/v1" fields {
    field domain_status id "gooo://service-policy/checked-matcher/domain_status" type string required one
    field invalid_field id "gooo://service-policy/checked-matcher/invalid_field" type string required one
    field matched id "gooo://service-policy/checked-matcher/matched" type boolean required one
}
activity GoooPackage0ActivityMatchServicePattern(Text, Text, Text) -> Boolean id "gooo://agentmesh-prototype/match-service-pattern" computes "\nif input0 == \"\" || input1 == \"\" || input2 == \"\" { return false }\nif input0 == \"*\" { return true }\nlet split = -1\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n let end = offset + 3\n if end <= int64(len(input0)) {\n  if input0[offset:end] == \"://\" { if split == -1 { split = offset } }\n }\n}\nif split < 0 { return false }\nlet nameStart = split + 3\nlet patternType = input0[0:split]\nlet patternName = input0[nameStart:int64(len(input0))]\nif patternType != input1 || patternName == \"\" { return false }\nif patternName == \"*\" { return true }\nlet patternLength = int64(len(patternName))\nlet requestLength = int64(len(input2))\nif patternLength >= 2 {\n if patternName[0:2] == \"*.\" {\n  let suffix = patternName[1:patternLength]\n  let suffixLength = int64(len(suffix))\n  if requestLength < suffixLength { return false }\n  let suffixStart = requestLength - suffixLength\n  return input2[suffixStart:requestLength] == suffix\n }\n let tailStart = patternLength - 2\n if patternName[tailStart:patternLength] == \".*\" {\n  let prefixEnd = patternLength - 1\n  let prefix = patternName[0:prefixEnd]\n  if requestLength < prefixEnd { return false }\n  return input2[0:prefixEnd] == prefix\n }\n}\nreturn input2 == patternName\n"
activity GoooPackage1ActivityValidateServiceType(Text) -> Boolean id "gooo://service-domain/type" computes "\nlet n = int64(len(input))\nif n > 128 { return false }\nif n == 0 { return true }\nlet first = int64(input[0])\nif !((first >= 65 && first <= 90) || (first >= 97 && first <= 122)) { return false }\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n if offset < n {\n  let b = int64(input[offset])\n  let alpha = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)\n  let digit = b >= 48 && b <= 57\n  if !alpha && !digit && b != 43 && b != 45 && b != 46 { return false }\n }\n}\nreturn true\n"
activity GoooPackage2ActivityValidateServiceName(Text) -> Boolean id "gooo://service-domain/name" computes "\nlet n = int64(len(input))\nif n > 128 { return false }\nif n == 0 { return true }\nlet previousDot = true\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n if offset < n {\n  let b = int64(input[offset])\n  if b == 46 {\n   if previousDot { return false }\n   previousDot = true\n  } else {\n   let alpha = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)\n   let digit = b >= 48 && b <= 57\n   if !alpha && !digit && b != 45 && b != 95 { return false }\n   previousDot = false\n  }\n }\n}\nreturn !previousDot\n"
activity GoooPackage3ActivityValidateServicePattern(Text) -> Boolean id "gooo://service-domain/pattern" computes "\nlet n = int64(len(input))\nif n > 128 { return false }\nif input == \"\" || input == \"*\" { return true }\nlet split = -1\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n let end = offset + 3\n if end <= n {\n  if input[offset:end] == \"://\" { if split == -1 { split = offset } }\n }\n}\nif split <= 0 { return false }\nlet typ = input[0:split]\nif !GoooPackage1ActivityValidateServiceType(typ) { return false }\nlet start = split + 3\nlet part = input[start:n]\nlet size = int64(len(part))\nif size == 0 { return false }\nif part == \"*\" { return true }\nif size >= 2 {\n if part[0:2] == \"*.\" { part = part[2:size] } else {\n  let tail = size - 2\n  if part[tail:size] == \".*\" { part = part[0:tail] }\n }\n}\nif part == \"\" { return false }\nreturn GoooPackage2ActivityValidateServiceName(part)\n"
activity GoooPackage4ActivityMatchServicePatternChecked(Text, Text, Text) -> CheckedMatcherDecision id "gooo://service-policy/checked-matcher/evaluate/v1" computes "\nif !GoooPackage3ActivityValidateServicePattern(input0) { return CheckedMatcherDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"pattern\", matched: false} }\nif !GoooPackage1ActivityValidateServiceType(input1) { return CheckedMatcherDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"req_type\", matched: false} }\nif !GoooPackage2ActivityValidateServiceName(input2) { return CheckedMatcherDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"req_name\", matched: false} }\nlet result = GoooPackage0ActivityMatchServicePattern(input0, input1, input2)\nreturn CheckedMatcherDecision{domain_status: \"VALID_INPUT\", invalid_field: \"\", matched: result}\n"
