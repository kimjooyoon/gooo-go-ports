package gooo_workspace
namespace gooo_workspace

entity Text id "gooo://std/text"
entity Boolean id "gooo://std/boolean"
entity GrantImpact id "gooo://service-impact/decision/v1" fields {
    field before_match id "gooo://service-impact/before" type boolean required one
    field after_match id "gooo://service-impact/after" type boolean required one
    field change id "gooo://service-impact/change" type string required one
}
entity GrantRefinement id "gooo://service-refinement/decision/v1" fields {
    field status id "gooo://service-refinement/status" type string required one
    field rule_id id "gooo://service-refinement/rule_id" type string required one
    field supported_subset id "gooo://service-refinement/supported_subset" type boolean required one
    field has_witness id "gooo://service-refinement/has_witness" type boolean required one
    field witness_type id "gooo://service-refinement/witness_type" type string required one
    field witness_name id "gooo://service-refinement/witness_name" type string required one
    field before_match id "gooo://service-refinement/before_match" type boolean required one
    field after_match id "gooo://service-refinement/after_match" type boolean required one
}
entity CheckedImpactDecision id "gooo://service-policy/checked-impact/decision/v1" fields {
    field domain_status id "gooo://service-policy/checked-impact/domain_status" type string required one
    field invalid_field id "gooo://service-policy/checked-impact/invalid_field" type string required one
    field before_match id "gooo://service-policy/checked-impact/before_match" type boolean required one
    field after_match id "gooo://service-policy/checked-impact/after_match" type boolean required one
    field change id "gooo://service-policy/checked-impact/change" type string required one
}
entity CheckedRefinementDecision id "gooo://service-policy/checked-refinement/decision/v1" fields {
    field domain_status id "gooo://service-policy/checked-refinement/domain_status" type string required one
    field invalid_field id "gooo://service-policy/checked-refinement/invalid_field" type string required one
    field status id "gooo://service-policy/checked-refinement/status" type string required one
    field rule_id id "gooo://service-policy/checked-refinement/rule_id" type string required one
    field supported_subset id "gooo://service-policy/checked-refinement/supported_subset" type boolean required one
    field has_witness id "gooo://service-policy/checked-refinement/has_witness" type boolean required one
    field witness_type id "gooo://service-policy/checked-refinement/witness_type" type string required one
    field witness_name id "gooo://service-policy/checked-refinement/witness_name" type string required one
    field before_match id "gooo://service-policy/checked-refinement/before_match" type boolean required one
    field after_match id "gooo://service-policy/checked-refinement/after_match" type boolean required one
}
entity GrantUpdateDecision id "gooo://service-policy/conditional-apply/decision/v1" fields {
    field status id "gooo://service-policy/conditional-apply/status" type string required one
    field reason id "gooo://service-policy/conditional-apply/reason" type string required one
    field invalid_field id "gooo://service-policy/conditional-apply/invalid_field" type string required one
    field required_observed id "gooo://service-policy/conditional-apply/required_observed" type boolean required one
    field required_before_match id "gooo://service-policy/conditional-apply/required_before_match" type boolean required one
    field required_after_match id "gooo://service-policy/conditional-apply/required_after_match" type boolean required one
    field subset_rule_id id "gooo://service-policy/conditional-apply/subset_rule_id" type string required one
}
activity GoooPackage0ActivityMatchServicePattern(Text, Text, Text) -> Boolean id "gooo://agentmesh-prototype/match-service-pattern" computes "\nif input0 == \"\" || input1 == \"\" || input2 == \"\" { return false }\nif input0 == \"*\" { return true }\nlet split = -1\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n let end = offset + 3\n if end <= int64(len(input0)) {\n  if input0[offset:end] == \"://\" { if split == -1 { split = offset } }\n }\n}\nif split < 0 { return false }\nlet nameStart = split + 3\nlet patternType = input0[0:split]\nlet patternName = input0[nameStart:int64(len(input0))]\nif patternType != input1 || patternName == \"\" { return false }\nif patternName == \"*\" { return true }\nlet patternLength = int64(len(patternName))\nlet requestLength = int64(len(input2))\nif patternLength >= 2 {\n if patternName[0:2] == \"*.\" {\n  let suffix = patternName[1:patternLength]\n  let suffixLength = int64(len(suffix))\n  if requestLength < suffixLength { return false }\n  let suffixStart = requestLength - suffixLength\n  return input2[suffixStart:requestLength] == suffix\n }\n let tailStart = patternLength - 2\n if patternName[tailStart:patternLength] == \".*\" {\n  let prefixEnd = patternLength - 1\n  let prefix = patternName[0:prefixEnd]\n  if requestLength < prefixEnd { return false }\n  return input2[0:prefixEnd] == prefix\n }\n}\nreturn input2 == patternName\n"
activity GoooPackage1ActivityCompareServiceGrant(Text, Text, Text, Text) -> GrantImpact id "gooo://service-impact/compare" computes "\nlet before = GoooPackage0ActivityMatchServicePattern(input0, input2, input3)\nlet after = GoooPackage0ActivityMatchServicePattern(input1, input2, input3)\nlet change = \"UNCHANGED_DENY\"\nif before {\n if after { change = \"UNCHANGED_ALLOW\" } else { change = \"REVOKED\" }\n} else {\n if after { change = \"WIDENED\" }\n}\nreturn GrantImpact{before_match: before, after_match: after, change: change}\n"
activity GoooPackage2ActivityAnalyzeServiceGrant(Text, Text) -> GrantRefinement id "gooo://service-refinement/analyze" computes "\nlet rule = \"\"\nif input1 == \"\" { rule = \"CANDIDATE_EMPTY\" } else {\n if input0 == input1 { rule = \"IDENTICAL_PATTERNS\" } else { if input0 == \"*\" { rule = \"OLD_GLOBAL\" } }\n}\nlet oldType = \"\"\nlet candidateType = \"\"\nlet oldBase = \"\"\nlet candidateBase = \"\"\nlet oldKind = \"NONE\"\nlet candidateKind = \"NONE\"\nlet oldSplit = -1\nlet candidateSplit = -1\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n let end = offset + 3\n if end <= int64(len(input0)) {\n  if input0[offset:end] == \"://\" { if oldSplit == -1 { oldSplit = offset } }\n }\n if end <= int64(len(input1)) {\n  if input1[offset:end] == \"://\" { if candidateSplit == -1 { candidateSplit = offset } }\n }\n}\nif oldSplit > 0 {\n oldType = input0[0:oldSplit]\n let start = oldSplit + 3\n oldBase = input0[start:int64(len(input0))]\n oldKind = \"EXACT\"\n if oldBase == \"*\" { oldKind = \"TYPED_ALL\" } else {\n  let n = int64(len(oldBase))\n  if n >= 2 {\n   if oldBase[0:2] == \"*.\" { oldKind = \"SUFFIX\"; oldBase = oldBase[2:n] } else {\n    let tail = n - 2\n    if oldBase[tail:n] == \".*\" { oldKind = \"PREFIX\"; oldBase = oldBase[0:tail] }\n   }\n  }\n }\n}\nif candidateSplit > 0 {\n candidateType = input1[0:candidateSplit]\n let start = candidateSplit + 3\n candidateBase = input1[start:int64(len(input1))]\n candidateKind = \"EXACT\"\n if candidateBase == \"*\" { candidateKind = \"TYPED_ALL\" } else {\n  let n = int64(len(candidateBase))\n  if n >= 2 {\n   if candidateBase[0:2] == \"*.\" { candidateKind = \"SUFFIX\"; candidateBase = candidateBase[2:n] } else {\n    let tail = n - 2\n    if candidateBase[tail:n] == \".*\" { candidateKind = \"PREFIX\"; candidateBase = candidateBase[0:tail] }\n   }\n  }\n }\n}\nif rule == \"\" {\n if oldKind == \"TYPED_ALL\" && candidateType == oldType { rule = \"OLD_TYPED_ALL\" }\n}\nif rule == \"\" {\n if candidateKind == \"EXACT\" {\n  if GoooPackage0ActivityMatchServicePattern(input0, candidateType, candidateBase) { rule = \"EXACT_CANDIDATE_ACCEPTED_BY_OLD\" }\n }\n}\nif rule == \"\" && oldType == candidateType {\n if oldKind == \"PREFIX\" && candidateKind == \"PREFIX\" {\n  if oldBase == candidateBase { rule = \"PREFIX_HIERARCHY\" } else {\n   let end = int64(len(oldBase)) + 1\n   if int64(len(candidateBase)) >= end {\n    if candidateBase[0:end] == oldBase + \".\" { rule = \"PREFIX_HIERARCHY\" }\n   }\n  }\n }\n if oldKind == \"SUFFIX\" && candidateKind == \"SUFFIX\" {\n  if oldBase == candidateBase { rule = \"SUFFIX_HIERARCHY\" } else {\n   let n = int64(len(candidateBase))\n   let size = int64(len(oldBase)) + 1\n   if n >= size {\n    let start = n - size\n    if candidateBase[start:n] == \".\" + oldBase { rule = \"SUFFIX_HIERARCHY\" }\n   }\n  }\n }\n}\nlet status = \"UNPROVEN\"\nlet supported = false\nif rule != \"\" { status = \"SUPPORTED_SUBSET\"; supported = true }\nlet witnessed = false\nlet witnessType = \"\"\nlet witnessName = \"\"\nlet witnessBefore = false\nlet witnessAfter = false\nif rule == \"\" {\n let firstType = candidateType\n let secondType = candidateType\n let firstName = \"\"\n let secondName = \"\"\n if input1 == \"*\" { firstType = \"a\"; secondType = \"b\"; firstName = \"x\"; secondName = \"x\" }\n if candidateKind == \"TYPED_ALL\" { firstName = \"x\"; secondName = \"y\" }\n if candidateKind == \"EXACT\" { firstName = candidateBase }\n if candidateKind == \"PREFIX\" { firstName = candidateBase + \".x\"; secondName = candidateBase + \".y\" }\n if candidateKind == \"SUFFIX\" { firstName = \"x.\" + candidateBase; secondName = \"y.\" + candidateBase }\n if firstName != \"\" {\n  let before = GoooPackage0ActivityMatchServicePattern(input0, firstType, firstName)\n  let after = GoooPackage0ActivityMatchServicePattern(input1, firstType, firstName)\n  if after && !before {\n   witnessed = true; witnessType = firstType; witnessName = firstName\n   witnessBefore = before; witnessAfter = after\n  }\n }\n if !witnessed && secondName != \"\" {\n  let before = GoooPackage0ActivityMatchServicePattern(input0, secondType, secondName)\n  let after = GoooPackage0ActivityMatchServicePattern(input1, secondType, secondName)\n  if after && !before {\n   witnessed = true; witnessType = secondType; witnessName = secondName\n   witnessBefore = before; witnessAfter = after\n  }\n }\n if witnessed { status = \"WIDENING_WITNESS\"; rule = \"CHECKED_CANDIDATE_REQUEST\" }\n}\nreturn GrantRefinement{status: status, rule_id: rule, supported_subset: supported, has_witness: witnessed, witness_type: witnessType, witness_name: witnessName, before_match: witnessBefore, after_match: witnessAfter}\n"
activity GoooPackage3ActivityValidateServiceType(Text) -> Boolean id "gooo://service-domain/type" computes "\nlet n = int64(len(input))\nif n > 128 { return false }\nif n == 0 { return true }\nlet first = int64(input[0])\nif !((first >= 65 && first <= 90) || (first >= 97 && first <= 122)) { return false }\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n if offset < n {\n  let b = int64(input[offset])\n  let alpha = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)\n  let digit = b >= 48 && b <= 57\n  if !alpha && !digit && b != 43 && b != 45 && b != 46 { return false }\n }\n}\nreturn true\n"
activity GoooPackage4ActivityValidateServiceName(Text) -> Boolean id "gooo://service-domain/name" computes "\nlet n = int64(len(input))\nif n > 128 { return false }\nif n == 0 { return true }\nlet previousDot = true\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n if offset < n {\n  let b = int64(input[offset])\n  if b == 46 {\n   if previousDot { return false }\n   previousDot = true\n  } else {\n   let alpha = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)\n   let digit = b >= 48 && b <= 57\n   if !alpha && !digit && b != 45 && b != 95 { return false }\n   previousDot = false\n  }\n }\n}\nreturn !previousDot\n"
activity GoooPackage5ActivityValidateServicePattern(Text) -> Boolean id "gooo://service-domain/pattern" computes "\nlet n = int64(len(input))\nif n > 128 { return false }\nif input == \"\" || input == \"*\" { return true }\nlet split = -1\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n let end = offset + 3\n if end <= n {\n  if input[offset:end] == \"://\" { if split == -1 { split = offset } }\n }\n}\nif split <= 0 { return false }\nlet typ = input[0:split]\nif !GoooPackage3ActivityValidateServiceType(typ) { return false }\nlet start = split + 3\nlet part = input[start:n]\nlet size = int64(len(part))\nif size == 0 { return false }\nif part == \"*\" { return true }\nif size >= 2 {\n if part[0:2] == \"*.\" { part = part[2:size] } else {\n  let tail = size - 2\n  if part[tail:size] == \".*\" { part = part[0:tail] }\n }\n}\nif part == \"\" { return false }\nreturn GoooPackage4ActivityValidateServiceName(part)\n"
activity GoooPackage6ActivityCompareServiceGrantChecked(Text, Text, Text, Text) -> CheckedImpactDecision id "gooo://service-policy/checked-impact/evaluate/v1" computes "\nif !GoooPackage5ActivityValidateServicePattern(input0) { return CheckedImpactDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"before\", before_match: false, after_match: false, change: \"INVALID_INPUT\"} }\nif !GoooPackage5ActivityValidateServicePattern(input1) { return CheckedImpactDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"after\", before_match: false, after_match: false, change: \"INVALID_INPUT\"} }\nif !GoooPackage3ActivityValidateServiceType(input2) { return CheckedImpactDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"req_type\", before_match: false, after_match: false, change: \"INVALID_INPUT\"} }\nif !GoooPackage4ActivityValidateServiceName(input3) { return CheckedImpactDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"req_name\", before_match: false, after_match: false, change: \"INVALID_INPUT\"} }\nlet result = GoooPackage1ActivityCompareServiceGrant(input0, input1, input2, input3)\nreturn CheckedImpactDecision{domain_status: \"VALID_INPUT\", invalid_field: \"\", before_match: result.before_match, after_match: result.after_match, change: result.change}\n"
activity GoooPackage7ActivityAnalyzeServiceGrantChecked(Text, Text) -> CheckedRefinementDecision id "gooo://service-policy/checked-refinement/evaluate/v1" computes "\nif !GoooPackage5ActivityValidateServicePattern(input0) { return CheckedRefinementDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"before\", status: \"INVALID_INPUT\", rule_id: \"\", supported_subset: false, has_witness: false, witness_type: \"\", witness_name: \"\", before_match: false, after_match: false} }\nif !GoooPackage5ActivityValidateServicePattern(input1) { return CheckedRefinementDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"after\", status: \"INVALID_INPUT\", rule_id: \"\", supported_subset: false, has_witness: false, witness_type: \"\", witness_name: \"\", before_match: false, after_match: false} }\nlet result = GoooPackage2ActivityAnalyzeServiceGrant(input0, input1)\nreturn CheckedRefinementDecision{domain_status: \"VALID_INPUT\", invalid_field: \"\", status: result.status, rule_id: result.rule_id, supported_subset: result.supported_subset, has_witness: result.has_witness, witness_type: result.witness_type, witness_name: result.witness_name, before_match: result.before_match, after_match: result.after_match}\n"
activity GoooPackage8ActivityAssessServiceGrantUpdate(Text, Text, Text, Text) -> GrantUpdateDecision id "gooo://service-policy/conditional-apply/assess/v1" computes "\nlet required = GoooPackage6ActivityCompareServiceGrantChecked(input0, input1, input2, input3)\nif required.domain_status == \"INVALID_INPUT\" {\n let bad = required.invalid_field\n let knownField = bad == \"before\" || bad == \"after\" || bad == \"req_type\" || bad == \"req_name\"\n if bad == \"req_type\" { bad = \"required_type\" }\n if bad == \"req_name\" { bad = \"required_name\" }\n if knownField && !required.before_match && !required.after_match && required.change == \"INVALID_INPUT\" {\n  return GrantUpdateDecision{status: \"INVALID_INPUT\", reason: \"INVALID_CANONICAL_INPUT\", invalid_field: bad, required_observed: false, required_before_match: false, required_after_match: false, subset_rule_id: \"\"}\n }\n return GrantUpdateDecision{status: \"REFUSED\", reason: \"DEPENDENCY_RESULT_INVALID\", invalid_field: \"\", required_observed: false, required_before_match: false, required_after_match: false, subset_rule_id: \"\"}\n}\nif required.domain_status != \"VALID_INPUT\" || required.invalid_field != \"\" {\n return GrantUpdateDecision{status: \"REFUSED\", reason: \"DEPENDENCY_RESULT_INVALID\", invalid_field: \"\", required_observed: false, required_before_match: false, required_after_match: false, subset_rule_id: \"\"}\n}\nlet impactConsistent = (required.before_match && required.after_match && required.change == \"UNCHANGED_ALLOW\") || (!required.before_match && !required.after_match && required.change == \"UNCHANGED_DENY\") || (!required.before_match && required.after_match && required.change == \"WIDENED\") || (required.before_match && !required.after_match && required.change == \"REVOKED\")\nif !impactConsistent {\n return GrantUpdateDecision{status: \"REFUSED\", reason: \"DEPENDENCY_RESULT_INVALID\", invalid_field: \"\", required_observed: false, required_before_match: false, required_after_match: false, subset_rule_id: \"\"}\n}\nif input2 == \"\" {\n return GrantUpdateDecision{status: \"INVALID_INPUT\", reason: \"EMPTY_REQUIRED_REQUEST\", invalid_field: \"required_type\", required_observed: false, required_before_match: false, required_after_match: false, subset_rule_id: \"\"}\n}\nif input3 == \"\" {\n return GrantUpdateDecision{status: \"INVALID_INPUT\", reason: \"EMPTY_REQUIRED_REQUEST\", invalid_field: \"required_name\", required_observed: false, required_before_match: false, required_after_match: false, subset_rule_id: \"\"}\n}\nif !required.before_match {\n return GrantUpdateDecision{status: \"REFUSED\", reason: \"CURRENT_REQUIRED_REQUEST_DENIED\", invalid_field: \"\", required_observed: true, required_before_match: required.before_match, required_after_match: required.after_match, subset_rule_id: \"\"}\n}\nlet grant = GoooPackage7ActivityAnalyzeServiceGrantChecked(input0, input1)\nif grant.domain_status != \"VALID_INPUT\" || grant.invalid_field != \"\" {\n return GrantUpdateDecision{status: \"REFUSED\", reason: \"DEPENDENCY_RESULT_INVALID\", invalid_field: \"\", required_observed: true, required_before_match: required.before_match, required_after_match: required.after_match, subset_rule_id: \"\"}\n}\nif grant.status == \"WIDENING_WITNESS\" && !grant.supported_subset && grant.has_witness && grant.rule_id == \"CHECKED_CANDIDATE_REQUEST\" && grant.witness_type != \"\" && grant.witness_name != \"\" && !grant.before_match && grant.after_match {\n return GrantUpdateDecision{status: \"REFUSED\", reason: \"WIDENING_WITNESS\", invalid_field: \"\", required_observed: true, required_before_match: required.before_match, required_after_match: required.after_match, subset_rule_id: \"\"}\n}\nif grant.status == \"UNPROVEN\" && !grant.supported_subset && !grant.has_witness && grant.rule_id == \"\" && grant.witness_type == \"\" && grant.witness_name == \"\" && !grant.before_match && !grant.after_match {\n return GrantUpdateDecision{status: \"REFUSED\", reason: \"REFINEMENT_UNPROVEN\", invalid_field: \"\", required_observed: true, required_before_match: required.before_match, required_after_match: required.after_match, subset_rule_id: \"\"}\n}\nlet knownRule = grant.rule_id == \"CANDIDATE_EMPTY\" || grant.rule_id == \"IDENTICAL_PATTERNS\" || grant.rule_id == \"OLD_GLOBAL\" || grant.rule_id == \"OLD_TYPED_ALL\" || grant.rule_id == \"EXACT_CANDIDATE_ACCEPTED_BY_OLD\" || grant.rule_id == \"PREFIX_HIERARCHY\" || grant.rule_id == \"SUFFIX_HIERARCHY\"\nlet subsetConsistent = grant.status == \"SUPPORTED_SUBSET\" && grant.supported_subset && !grant.has_witness && knownRule && grant.witness_type == \"\" && grant.witness_name == \"\" && !grant.before_match && !grant.after_match\nif !subsetConsistent {\n return GrantUpdateDecision{status: \"REFUSED\", reason: \"DEPENDENCY_RESULT_INVALID\", invalid_field: \"\", required_observed: true, required_before_match: required.before_match, required_after_match: required.after_match, subset_rule_id: \"\"}\n}\nif !required.after_match {\n return GrantUpdateDecision{status: \"REFUSED\", reason: \"REQUIRED_REQUEST_REMOVED\", invalid_field: \"\", required_observed: true, required_before_match: required.before_match, required_after_match: required.after_match, subset_rule_id: grant.rule_id}\n}\nreturn GrantUpdateDecision{status: \"ELIGIBLE\", reason: \"SUBSET_AND_REQUIRED_REQUEST_PRESERVED\", invalid_field: \"\", required_observed: true, required_before_match: required.before_match, required_after_match: required.after_match, subset_rule_id: grant.rule_id}\n"
