package gooo_workspace
namespace gooo_workspace

entity Text id "gooo://std/text"
entity Boolean id "gooo://std/boolean"
entity GrantRefinement id "gooo://service-refinement/decision/v1" fields {
    field status id "gooo://service-refinement/status" type string required one
    field rule_id id "gooo://service-refinement/rule_id" type string required one
    field supported_subset id "gooo://service-refinement/supported_subset" type boolean required one
    field has_witness id "gooo://service-refinement/has_witness" type boolean required one
    field witness_type id "gooo://service-refinement/witness_type" type string required one
    field witness_name id "gooo://service-refinement/witness_name" type string required one
    field before_match id "gooo://service-refinement/before_match" type boolean required one
    field after_match id "gooo://service-refinement/after_match" type boolean required one
}
entity CheckedRefinementDecision id "gooo://service-policy/checked-refinement/decision/v1" fields {
    field domain_status id "gooo://service-policy/checked-refinement/domain_status" type string required one
    field invalid_field id "gooo://service-policy/checked-refinement/invalid_field" type string required one
    field status id "gooo://service-policy/checked-refinement/status" type string required one
    field rule_id id "gooo://service-policy/checked-refinement/rule_id" type string required one
    field supported_subset id "gooo://service-policy/checked-refinement/supported_subset" type boolean required one
    field has_witness id "gooo://service-policy/checked-refinement/has_witness" type boolean required one
    field witness_type id "gooo://service-policy/checked-refinement/witness_type" type string required one
    field witness_name id "gooo://service-policy/checked-refinement/witness_name" type string required one
    field before_match id "gooo://service-policy/checked-refinement/before_match" type boolean required one
    field after_match id "gooo://service-policy/checked-refinement/after_match" type boolean required one
}
activity GoooPackage0ActivityMatchServicePattern(Text, Text, Text) -> Boolean id "gooo://agentmesh-prototype/match-service-pattern" computes "\nif input0 == \"\" || input1 == \"\" || input2 == \"\" { return false }\nif input0 == \"*\" { return true }\nlet split = -1\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n let end = offset + 3\n if end <= int64(len(input0)) {\n  if input0[offset:end] == \"://\" { if split == -1 { split = offset } }\n }\n}\nif split < 0 { return false }\nlet nameStart = split + 3\nlet patternType = input0[0:split]\nlet patternName = input0[nameStart:int64(len(input0))]\nif patternType != input1 || patternName == \"\" { return false }\nif patternName == \"*\" { return true }\nlet patternLength = int64(len(patternName))\nlet requestLength = int64(len(input2))\nif patternLength >= 2 {\n if patternName[0:2] == \"*.\" {\n  let suffix = patternName[1:patternLength]\n  let suffixLength = int64(len(suffix))\n  if requestLength < suffixLength { return false }\n  let suffixStart = requestLength - suffixLength\n  return input2[suffixStart:requestLength] == suffix\n }\n let tailStart = patternLength - 2\n if patternName[tailStart:patternLength] == \".*\" {\n  let prefixEnd = patternLength - 1\n  let prefix = patternName[0:prefixEnd]\n  if requestLength < prefixEnd { return false }\n  return input2[0:prefixEnd] == prefix\n }\n}\nreturn input2 == patternName\n"
activity GoooPackage1ActivityAnalyzeServiceGrant(Text, Text) -> GrantRefinement id "gooo://service-refinement/analyze" computes "\nlet rule = \"\"\nif input1 == \"\" { rule = \"CANDIDATE_EMPTY\" } else {\n if input0 == input1 { rule = \"IDENTICAL_PATTERNS\" } else { if input0 == \"*\" { rule = \"OLD_GLOBAL\" } }\n}\nlet oldType = \"\"\nlet candidateType = \"\"\nlet oldBase = \"\"\nlet candidateBase = \"\"\nlet oldKind = \"NONE\"\nlet candidateKind = \"NONE\"\nlet oldSplit = -1\nlet candidateSplit = -1\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n let end = offset + 3\n if end <= int64(len(input0)) {\n  if input0[offset:end] == \"://\" { if oldSplit == -1 { oldSplit = offset } }\n }\n if end <= int64(len(input1)) {\n  if input1[offset:end] == \"://\" { if candidateSplit == -1 { candidateSplit = offset } }\n }\n}\nif oldSplit > 0 {\n oldType = input0[0:oldSplit]\n let start = oldSplit + 3\n oldBase = input0[start:int64(len(input0))]\n oldKind = \"EXACT\"\n if oldBase == \"*\" { oldKind = \"TYPED_ALL\" } else {\n  let n = int64(len(oldBase))\n  if n >= 2 {\n   if oldBase[0:2] == \"*.\" { oldKind = \"SUFFIX\"; oldBase = oldBase[2:n] } else {\n    let tail = n - 2\n    if oldBase[tail:n] == \".*\" { oldKind = \"PREFIX\"; oldBase = oldBase[0:tail] }\n   }\n  }\n }\n}\nif candidateSplit > 0 {\n candidateType = input1[0:candidateSplit]\n let start = candidateSplit + 3\n candidateBase = input1[start:int64(len(input1))]\n candidateKind = \"EXACT\"\n if candidateBase == \"*\" { candidateKind = \"TYPED_ALL\" } else {\n  let n = int64(len(candidateBase))\n  if n >= 2 {\n   if candidateBase[0:2] == \"*.\" { candidateKind = \"SUFFIX\"; candidateBase = candidateBase[2:n] } else {\n    let tail = n - 2\n    if candidateBase[tail:n] == \".*\" { candidateKind = \"PREFIX\"; candidateBase = candidateBase[0:tail] }\n   }\n  }\n }\n}\nif rule == \"\" {\n if oldKind == \"TYPED_ALL\" && candidateType == oldType { rule = \"OLD_TYPED_ALL\" }\n}\nif rule == \"\" {\n if candidateKind == \"EXACT\" {\n  if GoooPackage0ActivityMatchServicePattern(input0, candidateType, candidateBase) { rule = \"EXACT_CANDIDATE_ACCEPTED_BY_OLD\" }\n }\n}\nif rule == \"\" && oldType == candidateType {\n if oldKind == \"PREFIX\" && candidateKind == \"PREFIX\" {\n  if oldBase == candidateBase { rule = \"PREFIX_HIERARCHY\" } else {\n   let end = int64(len(oldBase)) + 1\n   if int64(len(candidateBase)) >= end {\n    if candidateBase[0:end] == oldBase + \".\" { rule = \"PREFIX_HIERARCHY\" }\n   }\n  }\n }\n if oldKind == \"SUFFIX\" && candidateKind == \"SUFFIX\" {\n  if oldBase == candidateBase { rule = \"SUFFIX_HIERARCHY\" } else {\n   let n = int64(len(candidateBase))\n   let size = int64(len(oldBase)) + 1\n   if n >= size {\n    let start = n - size\n    if candidateBase[start:n] == \".\" + oldBase { rule = \"SUFFIX_HIERARCHY\" }\n   }\n  }\n }\n}\nlet status = \"UNPROVEN\"\nlet supported = false\nif rule != \"\" { status = \"SUPPORTED_SUBSET\"; supported = true }\nlet witnessed = false\nlet witnessType = \"\"\nlet witnessName = \"\"\nlet witnessBefore = false\nlet witnessAfter = false\nif rule == \"\" {\n let firstType = candidateType\n let secondType = candidateType\n let firstName = \"\"\n let secondName = \"\"\n if input1 == \"*\" { firstType = \"a\"; secondType = \"b\"; firstName = \"x\"; secondName = \"x\" }\n if candidateKind == \"TYPED_ALL\" { firstName = \"x\"; secondName = \"y\" }\n if candidateKind == \"EXACT\" { firstName = candidateBase }\n if candidateKind == \"PREFIX\" { firstName = candidateBase + \".x\"; secondName = candidateBase + \".y\" }\n if candidateKind == \"SUFFIX\" { firstName = \"x.\" + candidateBase; secondName = \"y.\" + candidateBase }\n if firstName != \"\" {\n  let before = GoooPackage0ActivityMatchServicePattern(input0, firstType, firstName)\n  let after = GoooPackage0ActivityMatchServicePattern(input1, firstType, firstName)\n  if after && !before {\n   witnessed = true; witnessType = firstType; witnessName = firstName\n   witnessBefore = before; witnessAfter = after\n  }\n }\n if !witnessed && secondName != \"\" {\n  let before = GoooPackage0ActivityMatchServicePattern(input0, secondType, secondName)\n  let after = GoooPackage0ActivityMatchServicePattern(input1, secondType, secondName)\n  if after && !before {\n   witnessed = true; witnessType = secondType; witnessName = secondName\n   witnessBefore = before; witnessAfter = after\n  }\n }\n if witnessed { status = \"WIDENING_WITNESS\"; rule = \"CHECKED_CANDIDATE_REQUEST\" }\n}\nreturn GrantRefinement{status: status, rule_id: rule, supported_subset: supported, has_witness: witnessed, witness_type: witnessType, witness_name: witnessName, before_match: witnessBefore, after_match: witnessAfter}\n"
activity GoooPackage2ActivityValidateServiceType(Text) -> Boolean id "gooo://service-domain/type" computes "\nlet n = int64(len(input))\nif n > 128 { return false }\nif n == 0 { return true }\nlet first = int64(input[0])\nif !((first >= 65 && first <= 90) || (first >= 97 && first <= 122)) { return false }\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n if offset < n {\n  let b = int64(input[offset])\n  let alpha = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)\n  let digit = b >= 48 && b <= 57\n  if !alpha && !digit && b != 43 && b != 45 && b != 46 { return false }\n }\n}\nreturn true\n"
activity GoooPackage3ActivityValidateServiceName(Text) -> Boolean id "gooo://service-domain/name" computes "\nlet n = int64(len(input))\nif n > 128 { return false }\nif n == 0 { return true }\nlet previousDot = true\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n if offset < n {\n  let b = int64(input[offset])\n  if b == 46 {\n   if previousDot { return false }\n   previousDot = true\n  } else {\n   let alpha = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)\n   let digit = b >= 48 && b <= 57\n   if !alpha && !digit && b != 45 && b != 95 { return false }\n   previousDot = false\n  }\n }\n}\nreturn !previousDot\n"
activity GoooPackage4ActivityValidateServicePattern(Text) -> Boolean id "gooo://service-domain/pattern" computes "\nlet n = int64(len(input))\nif n > 128 { return false }\nif input == \"\" || input == \"*\" { return true }\nlet split = -1\nlet offset = 0\nfor offset = 0; offset < 128; offset = offset + 1 {\n let end = offset + 3\n if end <= n {\n  if input[offset:end] == \"://\" { if split == -1 { split = offset } }\n }\n}\nif split <= 0 { return false }\nlet typ = input[0:split]\nif !GoooPackage2ActivityValidateServiceType(typ) { return false }\nlet start = split + 3\nlet part = input[start:n]\nlet size = int64(len(part))\nif size == 0 { return false }\nif part == \"*\" { return true }\nif size >= 2 {\n if part[0:2] == \"*.\" { part = part[2:size] } else {\n  let tail = size - 2\n  if part[tail:size] == \".*\" { part = part[0:tail] }\n }\n}\nif part == \"\" { return false }\nreturn GoooPackage3ActivityValidateServiceName(part)\n"
activity GoooPackage5ActivityAnalyzeServiceGrantChecked(Text, Text) -> CheckedRefinementDecision id "gooo://service-policy/checked-refinement/evaluate/v1" computes "\nif !GoooPackage4ActivityValidateServicePattern(input0) { return CheckedRefinementDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"before\", status: \"INVALID_INPUT\", rule_id: \"\", supported_subset: false, has_witness: false, witness_type: \"\", witness_name: \"\", before_match: false, after_match: false} }\nif !GoooPackage4ActivityValidateServicePattern(input1) { return CheckedRefinementDecision{domain_status: \"INVALID_INPUT\", invalid_field: \"after\", status: \"INVALID_INPUT\", rule_id: \"\", supported_subset: false, has_witness: false, witness_type: \"\", witness_name: \"\", before_match: false, after_match: false} }\nlet result = GoooPackage1ActivityAnalyzeServiceGrant(input0, input1)\nreturn CheckedRefinementDecision{domain_status: \"VALID_INPUT\", invalid_field: \"\", status: result.status, rule_id: result.rule_id, supported_subset: result.supported_subset, has_witness: result.has_witness, witness_type: result.witness_type, witness_name: result.witness_name, before_match: result.before_match, after_match: result.after_match}\n"
