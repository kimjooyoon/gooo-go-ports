+
+import path from 'node:path';
+
+import type {ParsedAsmResult} from '../../types/asmresult/asmresult.interfaces.js';
+import type {
+    ActiveTool,
+    BypassCache,
+    CompilationResult,
+    ExecutionOptionsWithEnv,
+    ExecutionParams,
+    FiledataPair,
+} from '../../types/compilation/compilation.interfaces.js';
+import type {ConfiguredOverrides} from '../../types/compilation/compiler-overrides.interfaces.js';
+import type {PreliminaryCompilerInfo} from '../../types/compiler.interfaces.js';
+import type {ParseFiltersAndOutputOptions} from '../../types/features/filters.interfaces.js';
+import type {SelectedLibraryVersion} from '../../types/libraries/libraries.interfaces.js';
+import {BaseCompiler} from '../base-compiler.js';
+import type {CompilationEnvironment} from '../compilation-env.js';
+import type {ClientOptionsType} from '../options-handler.js';
+import {BaseParser} from './argument-parsers.js';
+
+const inactiveBackendOptions = new Set([
+    'executorRequest',
+    'skipAsm',
+    'producePp',
+    'produceAst',
+    'produceStackUsageInfo',
+    'produceOptInfo',
+    'produceGnatDebugTree',
+    'produceGnatDebug',
+    'produceIr',
+    'produceClangir',
+    'produceOptPipeline',
+    'produceDevice',
+    'produceRustMir',
+    'produceRustMacroExp',
+    'produceRustHir',
+    'produceHaskellCore',
+    'produceHaskellStg',
+    'produceHaskellCmm',
+    'produceLeanC',
+    'produceClojureMacroExp',
+    'produceYul',
+]);
+
+class GoooSourceViewInputError extends Error {}
+
+export class GoooCompiler extends BaseCompiler {
+    static get key() {
+        return 'gooo';
+    }
+
+    constructor(compilerInfo: PreliminaryCompilerInfo, env: CompilationEnvironment) {
+        super(
+            {
+                ...compilerInfo,
+                versionFlag: ['version'],
+                supportsBinary: false,
+                supportsBinaryObject: false,
+                supportsExecute: false,
+                supportsAsmDocs: false,
+                supportsDemangle: false,
+                supportsIntel: false,
+                intelAsm: '',
+                supportsOptOutput: false,
+                supportsVerboseAsm: false,
+                supportsStackUsageOutput: false,
+                supportsCfg: false,
+                supportsPpView: false,
+                supportsAstView: false,
+                supportsIrView: false,
+                tools: {},
+                libsArr: [],
+                possibleOverrides: [],
+                postProcess: [],
+                disabledFilters: [
+                    'binary',
+                    'binaryObject',
+                    'execute',
+                    'demangle',
+                    'intel',
+                    'labels',
+                    'libraryCode',
+                    'directives',
+                    'commentOnly',
+                    'trim',
+                    'debugCalls',
+                ],
+            },
+            env,
+        );
+    }
+
+    override getArgumentParserClass(): typeof BaseParser {
+        return BaseParser;
+    }
+
+    override getCompilerResultLanguageId(_filters?: ParseFiltersAndOutputOptions): string {
+        return 'go';
+    }
+
+    override isCfgCompiler(): boolean {
+        return false;
+    }
+
+    override initialiseLibraries(_clientOptions: ClientOptionsType): void {
+        this.supportedLibraries = {};
+    }
+
+    override getDefaultExecOptions(): ExecutionOptionsWithEnv {
+        const options = super.getDefaultExecOptions();
+        return {
+            ...options,
+            env: {...options.env, GOOO_LAYA_URL: '', GOOO_LAYA_API_KEY: ''},
+        };
+    }
+
+    private activityFromOptions(options: string[]): string {
+        if (!Array.isArray(options) || options.some(option => typeof option !== 'string')) {
+            throw new GoooSourceViewInputError('Gooo source view requires only --activity NAME as string arguments');
+        }
+        const activity =
+            options.length === 2 && options[0] === '--activity'
+                ? options[1]
+                : options.length === 1 && options[0].startsWith('--activity=')
+                  ? options[0].slice('--activity='.length)
+                  : '';
+        // Match the Gooo lexer's Unicode letter/digit identifier contract.
+        if (!/^[_\p{L}][_\p{L}\p{Nd}]*$/u.test(activity)) {
+            throw new GoooSourceViewInputError(
+                'Gooo source view requires only --activity NAME, with a valid activity name',
+            );
+        }
+        return activity;
+    }
+
+    private checkSourceViewOptions(
+        filters: ParseFiltersAndOutputOptions,
+        backendOptions: Record<string, any>,
+        libraries: SelectedLibraryVersion[],
+        overrides: ConfiguredOverrides,
+    ): void {
+        if (filters.binary || filters.binaryObject || filters.execute) {
+            throw new GoooSourceViewInputError('Gooo source view does not support binary output or execution');
+        }
+        if (libraries.length > 0 || overrides.length > 0) {
+            throw new GoooSourceViewInputError('Gooo source view does not support libraries or compiler overrides');
+        }
+        if (this.compiler.options.trim()) {
+            throw new GoooSourceViewInputError(
+                'Gooo source view does not support additional configured compiler options',
+            );
+        }
+
+        for (const [name, value] of Object.entries(backendOptions)) {
+            if (name === 'overrides' && Array.isArray(value) && value.length === 0) continue;
+            if (inactiveBackendOptions.has(name) && (value === false || value === null || value === undefined)) {
+                continue;
+            }
+            if (
+                name === 'produceGccDump' &&
+                value !== null &&
+                typeof value === 'object' &&
+                !Array.isArray(value) &&
+                (value.opened === false || value.opened === undefined)
+            ) {
+                continue;
+            }
+            if (name === 'produceCfg' && (value === false || (value?.asm === false && value?.ir === false))) {
+                continue;
+            }
+            throw new GoooSourceViewInputError(`Gooo source view does not support backend option ${name}`);
+        }
+    }
+
+    override prepareArguments(
+        userOptions: string[],
+        filters: ParseFiltersAndOutputOptions,
+        backendOptions: Record<string, any>,
+        inputFilename: string,
+        _outputFilename: string,
+        libraries: SelectedLibraryVersion[],
+        overrides: ConfiguredOverrides,
+    ): string[] {
+        this.checkSourceViewOptions(filters, backendOptions, libraries, overrides);
+        return ['body-codegen', '--activity', this.activityFromOptions(userOptions), inputFilename];
+    }
+
+    override async compile(
+        source: string,
+        options: string[],
+        backendOptions: Record<string, any>,
+        filters: ParseFiltersAndOutputOptions,
+        bypassCache: BypassCache,
+        tools: ActiveTool[],
+        executeParameters: ExecutionParams,
+        libraries: SelectedLibraryVersion[],
+        files: FiledataPair[],
+    ): Promise<CompilationResult> {
+        try {
+            this.activityFromOptions(options);
+            this.checkSourceViewOptions(filters, backendOptions, libraries, backendOptions.overrides || []);
+            if (tools.length > 0 || files.length > 0) {
+                throw new GoooSourceViewInputError('Gooo source view supports one source file and no tools');
+            }
+        } catch (error) {
+            if (!(error instanceof GoooSourceViewInputError)) throw error;
+            return {
+                code: 1,
+                timedOut: false,
+                okToCache: false,
+                languageId: this.getCompilerResultLanguageId(),
+                asm: [],
+                stdout: [],
+                stderr: [{text: error.message}],
+            };
+        }
+        return super.compile(
+            source,
+            options,
+            backendOptions,
+            filters,
+            bypassCache,
+            tools,
+            executeParameters,
+            libraries,
+            files,
+        );
+    }
+
+    override async runCompiler(
+        compiler: string,
+        options: string[],
+        inputFilename: string,
+        execOptions: ExecutionOptionsWithEnv,
+        _filters?: ParseFiltersAndOutputOptions,
+    ): Promise<CompilationResult> {
+        if (options.length !== 4 || options[0] !== 'body-codegen' || options[3] !== inputFilename) {
+            throw new Error('Invalid Gooo source view arguments');
+        }
+        this.activityFromOptions(options.slice(1, 3));
+        const childOptions = {
+            ...execOptions,
+            customCwd: execOptions.customCwd || path.dirname(inputFilename),
+            env: {...execOptions.env, GOOO_LAYA_URL: '', GOOO_LAYA_API_KEY: ''},
+        };
+        const output = await this.exec(compiler, options, childOptions);
+        const failed = output.code !== 0 || output.timedOut || output.truncated;
+        return {
+            ...this.transformToCompilationResult(output, inputFilename),
+            code: failed && output.code === 0 ? -1 : output.code,
+            languageId: this.getCompilerResultLanguageId(),
+            stdout: [],
+            asm: failed ? '<Compilation failed>' : output.stdout,
+        };
+    }
+
+    override async postProcess(
+        result: CompilationResult,
+        _outputFilename: string,
+        _filters: ParseFiltersAndOutputOptions,
+        _produceOptRemarks = false,
+    ): Promise<[CompilationResult, [], []]> {
+        if (result.code !== 0) result.asm = '<Compilation failed>';
+        return [result, [], []];
+    }
+
+    override async processAsm(
+        result: CompilationResult,
+        _filters: ParseFiltersAndOutputOptions,
+        _options: string[],
+    ): Promise<ParsedAsmResult> {
+        return {
+            asm: typeof result.asm === 'string' ? result.asm.split('\n').map(text => ({text})) : result.asm || [],
+            languageId: 'go',
+            filteredCount: 0,
+        };
+    }
+}
