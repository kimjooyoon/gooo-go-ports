+monaco.languages.register({id: 'gooo'});
+monaco.languages.setMonarchTokensProvider('gooo', {
+    keywords: [
+        'package',
+        'namespace',
+        'import',
+        'entity',
+        'fields',
+        'field',
+        'id',
+        'type',
+        'activity',
+        'computes',
+        'required',
+        'optional',
+        'one',
+        'many',
+    ],
+    typeKeywords: ['integer', 'boolean', 'string'],
+    tokenizer: {
+        root: [
+            [/\/\/.*$/, 'comment'],
+            [/\/\*/, 'comment', '@comment'],
+            [
+                /[a-zA-Z_][a-zA-Z0-9_]*/,
+                {
+                    cases: {'@keywords': 'keyword', '@typeKeywords': 'type', '@default': 'identifier'},
+                },
+            ],
+            [/-?[0-9]+/, 'number'],
+            [/"/, 'string', '@quoted'],
+            [/`/, 'string', '@raw'],
+            [/->/, 'operator'],
+            [/[{}()[\]]/, '@brackets'],
+            [/[,:;]/, 'delimiter'],
+            [/[ \t\r\n]+/, 'white'],
+        ],
+        quoted: [
+            [/[^\\"]+/, 'string'],
+            [/\\./, 'string.escape'],
+            [/"/, 'string', '@pop'],
+        ],
+        raw: [
+            [/[^`]+/, 'string'],
+            [/`/, 'string', '@pop'],
+        ],
+        comment: [
+            [/[^/*]+/, 'comment'],
+            [/\*\//, 'comment', '@pop'],
+            [/[/*]/, 'comment'],
+        ],
+    },
+});
